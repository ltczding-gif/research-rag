  ],
  "type": "OBJECT",
  "propertyOrdering": [
    "research_domain",
    "document_type",
    "article_granularity",
    "primary_routing_key_value",
    "primary_routing_key_label",
    "recommended_template",
    "routing_confidence",
    "is_review_like",
    "is_multichapter_thesis",
    "routing_evidence",
    "warnings"
  ],
  "properties": {
    "research_domain": {
      "type": "STRING",
      "enum": [
        "TODO-subdomain-1",
        "TODO-subdomain-2",
        "TODO-subdomain-3",
        "TODO-subdomain-4",
        "TODO-subdomain-5",
        "multidomain",
        "other"
      ]
    },
    "document_type": {
      "type": "STRING",
      "enum": [
        "research-article",
        "review",
        "perspective",
        "commentary",
        "book-chapter",
        "phd-dissertation",
        "patent",
        "textbook",
        "preprint",
        "other"
      ]
    },
    "article_granularity": {
      "type": "STRING",
      "enum": [
        "experimental-paper",
        "methods-paper",
        "theory-paper",
        "review-like",
        "multichapter-thesis",
        "reference-like",
        "other"
      ]
    },
    "primary_routing_key_value": {
      "type": "STRING",
      "nullable": true,
      "description": "Field-specific identifier for this paper's primary routing context. Format defined by your pack's primary_routing_key.field_name in pack.yaml. Examples: catalysis 'CO2RR-Cu-MEA'; biology 'loss-of-function-screen'; ML 'image-classification-imagenet'."
