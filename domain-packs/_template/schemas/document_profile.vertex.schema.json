    "primary_routing_key_label": {
      "type": "STRING",
      "nullable": true,
      "description": "Human-readable label for primary_routing_key_value, used for display. May equal the value or be a longer prose form."
    },
    "recommended_template": {
      "type": "STRING",
      "enum": [
        "research-article",
        "review-or-perspective",
