      "minItems": 1,
      "maxItems": 8
    },
    "warnings": {
      "type": "ARRAY",
      "items": {
        "type": "STRING"
      }
    }
  },
  "required": [
    "research_domain",
    "document_type",
    "article_granularity",
    "recommended_template",
    "routing_confidence",
    "is_review_like",
    "is_multichapter_thesis",
    "routing_evidence",
    "warnings"
