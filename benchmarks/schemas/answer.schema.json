{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ltczding-gif/research-rag/benchmarks/schemas/answer.schema.json",
  "title": "Query-level answer key",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "query_id",
    "reference_answer",
    "expected_claim_ids",
    "acceptable_abstention"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "query_id": {"$ref": "#/$defs/id"},
    "reference_answer": {"type": ["string", "null"]},
    "expected_claim_ids": {
      "type": "array",
      "items": {"$ref": "#/$defs/id"},
      "uniqueItems": true
    },
    "acceptable_abstention": {"type": "boolean"},
    "abstention_reason": {"type": ["string", "null"]}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    }
  }
}
