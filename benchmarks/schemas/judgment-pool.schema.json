{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ltczding-gif/research-rag/benchmarks/schemas/judgment-pool.schema.json",
  "title": "Pooled judgment candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "query_id",
    "target_kind",
    "target_id",
    "source_run_ids"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "query_id": {"$ref": "#/$defs/id"},
    "target_kind": {"enum": ["document", "evidence"]},
    "target_id": {"$ref": "#/$defs/id"},
    "source_run_ids": {
      "type": "array",
      "items": {"$ref": "#/$defs/id"},
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    }
  }
}
