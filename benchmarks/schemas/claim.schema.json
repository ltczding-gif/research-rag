{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ltczding-gif/research-rag/benchmarks/schemas/claim.schema.json",
  "title": "Gold claim record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "paper_ids",
    "text",
    "evidence_group_ids"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "claim_id": {"$ref": "#/$defs/id"},
    "paper_ids": {
      "type": "array",
      "items": {"$ref": "#/$defs/id"},
      "minItems": 1,
      "uniqueItems": true
    },
    "text": {"type": "string", "minLength": 1},
    "evidence_group_ids": {
      "type": "array",
      "items": {"$ref": "#/$defs/id"},
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    }
  }
}
