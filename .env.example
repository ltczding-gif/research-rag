# ============================================================
# research-rag — environment configuration
#
# Copy this file to `.env` (kept out of git) and fill in your values.
# Required variables are marked [REQUIRED]; the rest have sensible defaults.
# ============================================================


# --- Path layout ---------------------------------------------------------
# Where your generated notes live (Markdown vault, also the discovery root
# for build_pdf_db.py via stub-note frontmatter).
# Default: <your home directory>/research-note — works on every OS without
# setting anything here. Uncomment to override; use an ABSOLUTE path
# ($HOME is not set on Windows cmd/PowerShell, so avoid relying on it):
#   macOS/Linux:  LOCALRAG_NOTES_DIR=/home/you/research-note
#   Windows:      LOCALRAG_NOTES_DIR=C:\Users\you\research-note
# LOCALRAG_NOTES_DIR=

# State directory — ChromaDB, ledgers, registry. Will be created if missing.
# Default: <your home directory>/.localrag — same override rules as above.
# LOCALRAG_HOME=

# Optional individual overrides (default to ${LOCALRAG_HOME}/<name>):
# LOCALRAG_CHROMA_PATH=$HOME/.localrag/chroma
# LOCALRAG_PDF_LEDGER=$HOME/.localrag/processed_groups.txt
# LOCALRAG_NOTES_LEDGER=$HOME/.localrag/processed_notes.txt
# LOCALRAG_TEXTBOOK_LEDGER=$HOME/.localrag/textbook_ledger.txt
# LOCALRAG_QUERY_LOG_ROOT=${LOCALRAG_NOTES_DIR}/_query_logs


# --- Zotero --------------------------------------------------------------
# [REQUIRED for note generation] Path to zotero.sqlite. Close Zotero before
# running scans (the SQLite database will be locked otherwise).
# Defaults to <your home directory>/Zotero/zotero.sqlite if unset — works
# on every OS without setting anything here. Uncomment to override with an
# ABSOLUTE path ($HOME is not set on Windows cmd/PowerShell):
#   macOS/Linux:  ZOTERO_DB_PATH=/home/you/Zotero/zotero.sqlite
#   Windows:      ZOTERO_DB_PATH=D:\Zotero\zotero.sqlite
# ZOTERO_DB_PATH=
# ZOTERO_DATA_DIR=
# Only set if you use Zotero linked-file mode with a base path:
# ZOTERO_ATTACHMENT_BASE_DIR=


# --- Embedding provider --------------------------------------------------
# Pick how vectors are produced for both the notes and papers collections.
#
#   fastembed      (default — in-process ONNX, zero daemons, zero API keys;
#                   the model (~0.2 GB, multilingual zh+en) downloads
#                   automatically on first use)
#   ollama         (local Ollama daemon — quality upgrade tier; see the
#                   qwen3-embedding table below)
#   openai-compat  (any provider exposing OpenAI's /v1/embeddings —
#                   OpenAI Inc., Voyage AI, Jina, Mistral, Aliyun DashScope,
#                   self-hosted TEI / Infinity / vLLM / LM Studio)
#
# Quality ladder: fastembed default gets you running with nothing else
# installed; switch to ollama + qwen3-embedding once you want the extra
# retrieval quality and have Ollama anyway. Switching providers/models
# against an existing ChromaDB requires a rebuild (see below).
LOCALRAG_EMBED_PROVIDER=fastembed

# --- fastembed (used when EMBED_PROVIDER=fastembed) -----------------------
# Any model id from fastembed's supported list works. The default is a
# 118M-param multilingual MiniLM — solid zh+en, 384-dim, CPU-friendly.
# LOCALRAG_FASTEMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2


# --- Ollama (local embedding service; used when EMBED_PROVIDER=ollama) ---
OLLAMA_EMBED_URL=http://localhost:11434/api/embeddings
#
# Embedding model — pick a tier that matches your hardware.
#
# Tier table (Ollama-pullable embedding models):
#
#   Tier      Model                       Disk   RAM    Dim    Multilingual?
#   small     all-minilm:l6-v2            45MB   250MB  384    EN-only
#   small     nomic-embed-text:v1.5       274MB  600MB  768    EN-leaning
#   medium    qwen3-embedding:0.6b        640MB  1.5GB  1024   strong CN+EN  ← default
#   medium    bge-m3                      1.2GB  2.5GB  1024   100+ langs
#   medium    mxbai-embed-large           669MB  1.2GB  1024   EN-strong
#   large     qwen3-embedding:4b          3GB    4-6GB  2560   strong CN+EN  ← upgrade target
#   xlarge    qwen3-embedding:8b          7.5GB  10GB+  4096   state-of-the-art
#
# Default: qwen3-embedding:0.6b. Comfortably fits 8GB-RAM laptops with
# 90%-ish quality of qwen3-embedding:4b on CN+EN retrieval. Sweet spot
# for ~10K papers (1024-dim balances ChromaDB index size vs quality).
#
# Upgrade to qwen3-embedding:4b when you have ≥16GB RAM and care about
# the last few percent of retrieval quality.
#
# Switching models against an EXISTING ChromaDB fails at query time
# (dim mismatch). Pick one:
#
# OPTION 1 (safest for existing users): revert OLLAMA_EMBED_MODEL to
#   whatever produces the dim you originally indexed at. No data loss;
#   query_server's startup guard will go green.
#
# OPTION 2 (rebuild — minutes to hours depending on corpus size):
#   Backup first if you have an indexed corpus you care about:
#     macOS/Linux: cp -r $LOCALRAG_HOME/chroma $LOCALRAG_HOME/chroma.bak
#     Windows:     Copy-Item -Recurse $env:LOCALRAG_HOME\chroma $env:LOCALRAG_HOME\chroma.bak
#   Then rebuild (macOS/Linux):
#     rm -rf $LOCALRAG_HOME/chroma
#     : > $LOCALRAG_HOME/processed_groups.txt
#     : > $LOCALRAG_HOME/processed_notes.txt
#     .venv/bin/python service/build_notes_db.py
#     .venv/bin/python service/build_pdf_db.py
#   Windows (PowerShell):
#     Remove-Item -Recurse -Force $env:LOCALRAG_HOME\chroma
#     Clear-Content $env:LOCALRAG_HOME\processed_groups.txt
#     Clear-Content $env:LOCALRAG_HOME\processed_notes.txt
#     .venv\Scripts\python.exe service\build_notes_db.py
#     .venv\Scripts\python.exe service\build_pdf_db.py
# Note: existing Markdown notes are preserved either way; only the
# ChromaDB embedding store gets rebuilt.
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
# Truncation ceiling on text fed to the embedding model. 12000 chars
# matches qwen3-embedding's 8192-token ceiling for Chinese-English mixed
# text (~2 chars/token). Adjust based on your model's context.
LOCALRAG_MAX_EMBED_CHARS=12000


# --- OpenAI-compatible embedding (used when EMBED_PROVIDER=openai-compat) ---
# Reachable providers via this single backend (set the right base URL):
#   OpenAI Inc.:    https://api.openai.com/v1                  (default)
#   Voyage AI:      https://api.voyageai.com/v1                strong, retrieval-tuned
#   Jina:           https://api.jina.ai/v1                     EU-hosted option, 89 langs
#   Mistral:        https://api.mistral.ai/v1                  EU residency
#   Aliyun:         https://dashscope.aliyuncs.com/compatible-mode/v1   Chinese-best
#   TEI / Infinity: http://localhost:8080/v1                   self-hosted
#   vLLM:           http://localhost:8000/v1                   self-hosted
#   LM Studio:      http://localhost:1234/v1                   self-hosted
OPENAI_EMBED_BASE_URL=https://api.openai.com/v1
OPENAI_EMBED_API_KEY=
# Reference defaults; pick a model your provider supports:
#   OpenAI:     text-embedding-3-small (1536-dim, $0.02/M tokens)
#               text-embedding-3-large (3072-dim, $0.13/M tokens)
#   Voyage:     voyage-3.5-lite (1024-dim, $0.02/M tokens)
#               voyage-3-large  (1024-dim, $0.18/M tokens)
#   DashScope:  text-embedding-v3 (1024-dim, ~$0.007/M tokens)
#   Jina:       jina-embeddings-v3 (1024-dim, $0.018/M tokens)
#   Mistral:    mistral-embed (1024-dim, $0.10/M tokens)
OPENAI_EMBED_MODEL=text-embedding-3-small


# --- Query server -------------------------------------------------------
LOCALRAG_HOST=127.0.0.1
LOCALRAG_PORT=18810


# --- Chunking (PDF papers) ----------------------------------------------
# Defaults match the original system. 100-char overlap (= SIZE - STEP).
LOCALRAG_CHUNK_SIZE=800
LOCALRAG_CHUNK_STEP=700
LOCALRAG_MIN_CHUNK_LEN=100
LOCALRAG_TEXTBOOK_BATCH_SIZE=50
LOCALRAG_NOTE_SUFFIX=_review_note.md


# --- Processor backend selection ----------------------------------------
# Which LLM backend the note generator uses. Pick one:
#
#   subagent    [EASIEST — start here] No external API needed. Writes a
#               manifest and lets a Claude Code sub-agent (Task tool) run
#               the model calls. Zero additional cloud spend if you already
#               use Claude Code. No credentials to configure below.
#   gemini-api  Direct Google AI Studio API key, PDFs sent inline. Get a
#               key in 1 minute at https://aistudio.google.com/apikey.
#               Needs GEMINI_API_KEY.
#   anthropic   Anthropic Claude with base64 PDFs and tool-use schema.
#               Get a key at https://console.anthropic.com/. Needs
#               ANTHROPIC_API_KEY.
#   openai      OpenAI Chat Completions protocol; PDFs sent as locally-
#               extracted text via pdfplumber. Works with OpenAI Inc. and
#               any compatible provider (DeepSeek, Mistral, OpenRouter,
#               Together, Groq, vLLM, Ollama, LM Studio, ...) via
#               OPENAI_BASE_URL. Needs OPENAI_API_KEY.
#   vertex      [HARDEST — best fidelity] Vertex AI Gemini with GCS upload.
#               Needs a GCP project, a service-account JSON, the Vertex AI
#               + Cloud Storage APIs enabled, and a GCS bucket. ~30 minutes
#               to set up the first time. Best PDF fidelity (figure-aware).
#               Needs the GOOGLE_* / GEMINI_VERTEX_* block below.
#
# Override per-invocation with --backend on the CLI.
LOCALRAG_PROCESSOR_BACKEND=subagent


# --- Vertex AI (only used when LOCALRAG_PROCESSOR_BACKEND=vertex) -------
# Service-account auth. Put the JSON outside the repo and never commit it.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_VERTEX_GCS_BUCKET=your-gcs-bucket-name
GEMINI_VERTEX_GCS_BUCKET_LOCATION=US

# Optional: pre-flight limits on PDFs (defaults match Vertex's own limits)
# GEMINI_VERTEX_MAX_PDF_BYTES=52428800
# GEMINI_VERTEX_MAX_PDF_PAGES=1000
# GEMINI_GCS_UPLOAD_TIMEOUT_SECONDS=900


# --- Direct Gemini API (only used when LOCALRAG_PROCESSOR_BACKEND=gemini-api) ---
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=


# --- Anthropic Claude (only used when LOCALRAG_PROCESSOR_BACKEND=anthropic) ---
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional model overrides — defaults below; only set if you want a specific Claude.
# ANTHROPIC_FLASH_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_PRO_MODEL=claude-sonnet-4-6


# --- OpenAI / OpenAI-compatible (only used when LOCALRAG_PROCESSOR_BACKEND=openai) ---
# Works with OpenAI Inc. AND any provider exposing the OpenAI protocol.
OPENAI_API_KEY=
# Leave OPENAI_BASE_URL blank for OpenAI Inc. Set it to point to compatible providers:
#   https://api.deepseek.com/v1                    (DeepSeek)
#   https://openrouter.ai/api/v1                   (OpenRouter — many models)
#   https://api.mistral.ai/v1                      (Mistral)
#   https://api.together.xyz/v1                    (Together)
#   https://api.groq.com/openai/v1                 (Groq)
#   http://localhost:11434/v1                      (Ollama OpenAI compatibility)
#   http://localhost:8000/v1                       (vLLM, LM Studio, etc.)
OPENAI_BASE_URL=
# Optional. Used by OpenAI Inc. for org-scoped billing; leave blank otherwise.
OPENAI_ORG_ID=
# Model translation for the orchestrator's flash/pro tiers. Override per provider.
# Examples: deepseek-chat / deepseek-reasoner ; mistral-small-latest / mistral-large-latest ;
#           qwen-plus / qwen-max ; gpt-4o-mini / gpt-4o.
# OPENAI_FLASH_MODEL=gpt-4o-mini
# OPENAI_PRO_MODEL=gpt-4o
# Some compatible providers (Groq, Together free tier) cap max_tokens below
# the default 8192. Lower this if you hit "max_tokens too large" errors.
# OPENAI_MAX_TOKENS=8192


# --- Python interpreters (cross-platform) -------------------------------
# Default: rely on PATH lookup. Override with absolute paths if your host
# has multiple Pythons and you need to pin a specific one.
LOCALRAG_MAIN_PYTHON=python3
LOCALRAG_RAG_PYTHON=python3


# --- Advanced -----------------------------------------------------------
# Skill root for the gemini-literature-processor scanner — defaults to
# the in-repo skills/gemini-literature-processor/ directory.
# GEMINI_LITERATURE_SKILL_ROOT=

# Pipeline report root (where canary notes land before promotion).
# Defaults to $LOCALRAG_NOTES_DIR/progress/pipeline_reports/gemini_incremental_alignment
# GEMINI_INCREMENTAL_ALIGNMENT_REPORT_ROOT=

# Set to "1" to skip ChromaDB connection at startup (useful for tests).
# LOCALRAG_SKIP_CHROMA_INIT=0
